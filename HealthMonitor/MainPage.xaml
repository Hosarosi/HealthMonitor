<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HealthMonitor.MainPage"
    Title="HealthMonitor"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F5FC">

    <ScrollView>
        <Grid Padding="32,24">

            <VerticalStackLayout
                Spacing="14"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                MaximumWidthRequest="900"
                Margin="0"
                >

                <Label
                    Text="HealthMonitor"
                    FontFamily="Georgia"
                    FontSize="36"
                    FontAttributes="Bold"
                    TextColor="#8064C8"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <Image
                    Source="healthmonitor.png"
                    HeightRequest="165"
                    WidthRequest="220"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />

                <Label
                    Text="Acompanhamento de Sinais Vitais"
                    FontFamily="Georgia"
                    FontSize="18"
                    FontAttributes="Italic"
                    TextColor="#776B91"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="0,-4,0,12" />

                <Entry
                    x:Name="EmailEntry"
                    Placeholder="E-mail"
                    Keyboard="Email"
                    BackgroundColor="White"
                    TextColor="#34265C"
                    PlaceholderColor="#A39AB8"
                    HeightRequest="48"
                    HorizontalOptions="Fill" />

                <Entry
                    x:Name="SenhaEntry"
                    Placeholder="Senha"
                    IsPassword="True"
                    BackgroundColor="White"
                    TextColor="#34265C"
                    PlaceholderColor="#A39AB8"
                    HeightRequest="48"
                    HorizontalOptions="Fill" />

                <Button
                    Text="Entrar"
                    Clicked="OnEntrarClicked"
                    BackgroundColor="#A58AE8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    Margin="0,4,0,0" />

                <Button
                    Text="Cadastrar usuário"
                    Clicked="OnCadastrarClicked"
                    BackgroundColor="White"
                    TextColor="#8064C8"
                    BorderColor="#C8B8EE"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"
                    HorizontalOptions="Fill" />

                <Label
                    Text="Cuidar hoje para um amanhã melhor."
                    FontFamily="Georgia"
                    FontSize="13"
                    FontAttributes="Italic"
                    TextColor="#776B91"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="0,8,0,0" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
