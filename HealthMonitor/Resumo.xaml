<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HealthMonitor.Resumo"
    BackgroundColor="#F8F5FC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Button
    Text="← Voltar para a tela inicial"
    Clicked="OnVoltarClicked"
    BackgroundColor="Transparent"
    TextColor="#8064C8"
    HorizontalOptions="Start"
    FontSize="14"
    Padding="0,8"
    Margin="18,10,0,0" />



            <Label
                Text="Resumo das medições"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#8064C8"
                HorizontalOptions="Center" />

            <Label
                Text="Acompanhe os dados da sua última medição."
                FontSize="14"
                TextColor="#776B91"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Border
                BackgroundColor="White"
                Stroke="#E9E1F8"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="14">
                    <Label Text="Total de medições"
                           FontSize="15"
                           TextColor="#776B91" />

                    <Label x:Name="TotalMedicoesLabel"
                           Text="Carregando..."
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#8064C8" />

                    <BoxView HeightRequest="1"
                             Color="#E9E1F8" />

                    <Label Text="Data da última medição"
                           FontSize="15"
                           TextColor="#776B91" />

                    <Label x:Name="DataUltimaLabel"
                           Text="Carregando..."
                           FontSize="17"
                           TextColor="#8064C8" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Últimos sinais vitais"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#8064C8" />

            <Border BackgroundColor="White"
                    Stroke="#E9E1F8"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Pressão arterial"
                               TextColor="#776B91"
                               VerticalOptions="Center" />
                        <Label x:Name="PressaoLabel"
                               Grid.Column="1"
                               Text="--/-- mmHg"
                               FontAttributes="Bold"
                               TextColor="#8064C8" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E9E1F8" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Frequência cardíaca"
                               TextColor="#776B91"
                               VerticalOptions="Center" />
                        <Label x:Name="FrequenciaLabel"
                               Grid.Column="1"
                               Text="-- bpm"
                               FontAttributes="Bold"
                               TextColor="#8064C8" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E9E1F8" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Temperatura"
                               TextColor="#776B91"
                               VerticalOptions="Center" />
                        <Label x:Name="TemperaturaLabel"
                               Grid.Column="1"
                               Text="-- °C"
                               FontAttributes="Bold"
                               TextColor="#8064C8" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E9E1F8" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Oxigenação"
                               TextColor="#776B91"
                               VerticalOptions="Center" />
                        <Label x:Name="OxigenacaoLabel"
                               Grid.Column="1"
                               Text="--%"
                               FontAttributes="Bold"
                               TextColor="#8064C8" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button
                Text="Atualizar resumo"
                Clicked="OnAtualizarClicked"
                BackgroundColor="#A58AE8"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
